# 复制为 .env.local 后填写。该文件已被 .gitignore 排除，不要提交真实密钥。

# ─── Kimi Code 模型 API Key ───
# 由 Kimi Code CLI 使用；项目不会直接调用 Kimi API。
KIMI_MODEL_NAME=kimi-for-coding
KIMI_MODEL_API_KEY=your-kimi-code-api-key
KIMI_MODEL_BASE_URL=https://api.kimi.com/coding/v1
KIMI_MODEL_PROVIDER_TYPE=kimi
KIMI_MODEL_MAX_CONTEXT_SIZE=262144

# ─── 本机 Kimi Code 问答连接 ───
# KIMI_CODE_TOKEN 是 Next.js 连接本机 kimi web 的凭据，不是上面的 API Key。
# 使用 start.bat 时，KIMI_CODE_PASSWORD 与 KIMI_CODE_TOKEN 填同一个随机本地字符串。
# 不要把真实密钥用作本地密码，也不要改成 NEXT_PUBLIC_* 变量。
KIMI_CODE_TOKEN=your-random-local-token
KIMI_CODE_PASSWORD=your-random-local-token
KIMI_CODE_LOCAL_URL=http://127.0.0.1:58627

# 可选：单次问答最长等待时间，默认 600000 毫秒（10 分钟）。
# KIMI_CODE_TIMEOUT_MS=600000

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
